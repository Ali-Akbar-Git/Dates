{{ 'custom-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-product.js' | asset_url }}" defer></script>
<div class="product-section">
  <div class="product-section-wrapper">
    <div class="image-section">
      <div id="image-list">
        {% for image in product.images %}
          <div
            class="list-image-box{% if image == product.featured_image %} active{% endif %}"
            data-image-url="{{ image | image_url: width: 1200 }}"
            data-full-image-url="{{ image | image_url: width: 2000 }}"
            data-image-id="{{ image.id }}">
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="list-image"
              loading="lazy">
          </div>
        {% endfor %}
      </div>
      <div class="main-image">
        <button
          type="button"
          class="image-navigation-button image-previous-button"
          aria-label="Previous product image">
          {% render 'icon-left' %}
        </button>
        <img
          id="mainProductImage"
          src="{{ product.featured_image | image_url: width: 1200 }}"
          data-full-image-url="{{ product.featured_image | image_url: width: 2000 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}">
        <button
          type="button"
          class="image-navigation-button image-next-button"
          aria-label="Next product image">
          {% render 'icon-right' %}
        </button>
      </div>
    </div>
    <div class="product-info-section">
      <h1 class="product-title">{{ product.title }}</h1>
      <div class="product-rating">
        <span class="rating-stars">★★★★★</span>
        <span class="rating-text">4.8 (124 Reviews)</span>
      </div>
      <div class="price-section">
        <span class="sale-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        <span class="regular-price">{{ product.selected_or_first_available_variant.price | times: 125 | divided_by: 100 | money }}</span>
      </div>
      {% assign selected_variant = product.selected_or_first_available_variant %}

      <div class="product-stock-status{% unless selected_variant.available %} sold-out{% elsif selected_variant.inventory_management and selected_variant.inventory_quantity <= section.settings.low_stock_limit %} low-stock{% endunless %}">
        <span class="stock-dot"></span>

        <span class="stock-status-text">
          {% unless selected_variant.available %}
            Sold out
          {% elsif selected_variant.inventory_management and selected_variant.inventory_quantity <= section.settings.low_stock_limit %}
            Only {{ selected_variant.inventory_quantity }} left in stock
          {% else %}
            In stock
          {% endunless %}
        </span>
      </div>
      <div class="delivery-estimate">
        🚚 Estimated delivery: 4–7 business days
      </div>
      <div class="product-variant-section">
        <span class="product-unit-span">{{ section.settings.variant_unit }}:
        </span>
        <span class="product-variant-title">
          {{ product.selected_or_first_available_variant.title }}
        </span>
      </div>
      <div class="variant-buttons">
        {% for variant in product.variants %}
          <button
            type="button"
            class="variant-button{% if variant.id == product.selected_or_first_available_variant.id %} active{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-variant-title="{{ variant.title }}"
            data-price="{{ variant.price | money }}"
            data-regular-price="{{ variant.price | times: 125 | divided_by: 100 | money }}"
            data-available="{{ variant.available }}"
            data-inventory-quantity="{{ variant.inventory_quantity }}"
            data-inventory-management="{{ variant.inventory_management }}"
            data-inventory-policy="{{ variant.inventory_policy }}"
            data-image-id="{{ variant.featured_image.id }}"
            {% unless variant.available %}
            disabled
            {% endunless %}>
            {{ variant.title }}
          </button>
        {% endfor %}
      </div>
      <div class="product-add-button-wrapper ">
        <div class="product-quantity-box">
          <div class="product-button-box">
            <button type="button" class="product-quantity-button minus">
              {% render 'icon-minus' %}
            </button>
          </div>
          <input
            class="product-quantity-input"
            type="text"
            inputmode="numeric"
            value="1">
          <div class="product-button-box">
            <button type="button" class="product-quantity-button plus">
              {% render 'icon-plus' %}
            </button>
          </div>
        </div>
        <button
          type="button"
          class="product-add-button"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          {% unless product.selected_or_first_available_variant.available %}
          disabled
          {% endunless %}>
          <span class="add-to-cart-button-text">
            {% if product.selected_or_first_available_variant.available %}
              Add to cart
            {% else %}
              Sold out
            {% endif %}
          </span>
        </button>
        <div class="product-add-error" role="alert"></div>
      </div>
      <div class="bargin-button-box">
        {% capture message %}
Can I get more discount on this product?
{{ product.title }}
{{ shop.url }}{{ product.url }}
{% endcapture %}
        <a
          class="product-bargin-button-link"
          href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ message | url_encode }}"
          target="_blank"
          rel="noopener noreferrer">
          <button
            type="button"
            class="product-bargin-button"
            {% unless product.selected_or_first_available_variant.available %}
            disabled
            {% endunless %}>
            <span class="bargin-button-text">
              Need More Discount? Bargain Now
            </span>
          </button>
        </a>
      </div>
      <div class="trust-badges">
        <div class="trust-badge">
          🔒 Secure Payment
        </div>

        <div class="trust-badge">
          🚚 Fast Delivery
        </div>

        <div class="trust-badge">
          ↩️ Easy Returns
        </div>
      </div>
    </div>
  </div>
</div>
<div class="full-image-drawer">
  <img
    id="fullMainProductImage"
    src="{{ product.featured_image | image_url: width: 2000 }}"
    alt="{{ product.featured_image.alt | escape }}"
    width="{{ product.featured_image.width }}"
    height="{{ product.featured_image.height }}">
  <div class="inner-image-navigation-buttons">
    <button
      type="button"
      id="innerPreviousButton"
      class="inner-image-navigation-button"
      aria-label="Previous product image">
      {% render 'icon-left' %}
    </button>
    <button
      type="button"
      id="innerCloseButton"
      class="inner-image-navigation-button"
      aria-label="Close product image">
      {% render 'icon-close' %}
    </button>
    <button
      type="button"
      id="innerNextButton"
      class="inner-image-navigation-button"
      aria-label="Next product image">
      {% render 'icon-right' %}
    </button>
  </div>
</div>
{% schema %}
  {
    "name": "Product",
    "settings": [
      {
        "type": "text",
        "id": "variant_unit",
        "label": "Variant unit",
        "default": "Weight"
      }, {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "Enter the number in international format without + or spaces. Example: 922137170069",
        "default": "923420696209"
      }, {
        "type": "range",
        "id": "low_stock_limit",
        "label": "Low stock limit",
        "min": 1,
        "max": 50,
        "step": 1,
        "default": 5
      },
      {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Banner Image",
        "info": "Upload a banner image to display below the product section."
      }
    ],
    "presets": [
      {
        "name": "Product"
      }
    ]
  }
{% endschema %}