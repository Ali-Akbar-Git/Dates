{{ 'custom-FAQs.css' | asset_url | stylesheet_tag }}
<div class="custom-FAQs">
  <h2 class="custom-FAQs__title">{{ section.settings.heading }}</h2>
  <div class="custom-FAQs__content">
    {% content_for 'blocks' %}
  </div>
</div>
{% schema %}
  {
    "name": "FAQs",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Frequently Asked Questions"
      }
    ],
    "blocks": [
      {
        "type": "_faqs-item"
      }
    ],
    "presets": [
      {
        "name": "FAQs"
      }
    ]
  }
{% endschema %}