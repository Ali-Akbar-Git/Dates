{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<div class="custom-product-grid">
  <div class="section-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="cards">
    {% assign collection = section.settings.collection %}
    {% if collection %}
    {% for product in collection.products %}
      {% render 'grid-card'
        , product: product %}
    {% endfor %}
    {% else %}
      <p>No collection selected.</p>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Product Grid",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "MADINA DATES"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      }
    ],
    "presets": [
      {
        "name": "Product Grid"
      }
    ]
  }
{% endschema %}